# Django secret key.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
# Public application display name.
APP_NAME=YourAppName
# Public base URL used for security-sensitive email links.
APP_BASE_URL=http://127.0.0.1:8000
# Fernet key for encrypted 2FA secrets at rest.
FERNET_KEY=replace-with-a-generated-fernet-key
# Enable debug mode in local only.
DJANGO_DEBUG=True
# Comma-separated allowed hosts.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF trusted origins.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Comma-separated proxy IPs allowed to provide X-Forwarded-For.
TRUSTED_PROXY_IPS=

# Database backend. Use django.db.backends.mysql in production.
DB_ENGINE=django.db.backends.sqlite3

# MySQL configuration.
DB_NAME=django_htmx
DB_USER=root
DB_PASSWORD=secret
DB_HOST=127.0.0.1
DB_PORT=3306
# Persistent DB connections in seconds.
DB_CONN_MAX_AGE=60

# Redis/Celery.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email driver: log or smtp.
MAIL_DRIVER=log
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=YourAppName
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
# File path used when MAIL_DRIVER=log.
MAIL_LOG_PATH=logs/mail

# Cookie/HSTS security.
# Session idle timeout in seconds (15 minutes).
SESSION_IDLE_TIMEOUT=900
# Absolute session lifetime in seconds (8 hours).
SESSION_ABSOLUTE_TIMEOUT=28800
# Login lockout settings.
LOGIN_FAILURE_THRESHOLD=5
LOGIN_FAILURE_BASE_LOCK_SECONDS=30
LOGIN_FAILURE_MAX_LOCK_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=86400
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
